<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="012-notify-outbox" author="roam">
        <createTable tableName="notify_outbox" remarks="通知投递失败暂存，定时重投">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="payload" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(16)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="attempts" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="next_retry_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="created_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="notify_outbox" indexName="idx_outbox_status_retry">
            <column name="status"/>
            <column name="next_retry_time"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
