# 复制成 .env 再改；docker compose 会自动读取同目录下的 .env
# 生产环境务必改掉这两个密码，并换一个真正的 JWT secret

MYSQL_ROOT_PASSWORD=change-me-mysql
REDIS_PASSWORD=change-me-redis

# 至少 32 字节；可以用 openssl rand -base64 48 生成
ROAM_JWT_SECRET=please-change-this-to-a-random-string-at-least-32-bytes

# 写操作限流：每用户/每 IP 每分钟次数
ROAM_WRITE_PER_MINUTE=30

# RabbitMQ（compose 内的 rabbitmq 服务；宿主机端口 25672/25673）
RABBITMQ_USER=roam
RABBITMQ_PASSWORD=change-me-rabbit

# 语义召回：需要智谱 embedding key；不填则搜索只走 BM25
ROAM_SEARCH_VECTOR_ENABLED=false
ROAM_EMBEDDING_API_KEY=
ROAM_EMBEDDING_MODEL=embedding-3
